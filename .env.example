# Образец. На боевом Mac .env создаёт scripts/setup-mac.sh (права 600).

DATABASE_URL='postgresql://USER@localhost:5432/tronflow'

# Вход в дашборд
ADMIN_PASSWORD='минимум-10-символов'
SESSION_SECRET='сгенерируйте: openssl rand -hex 32'
# SESSION_TTL_HOURS='168'

# Веб-сервер: 127.0.0.1 — только этот Mac, 0.0.0.0 — вся локальная сеть
HOST='127.0.0.1'
PORT='3000'

# TronGrid: ключ бесплатно на https://www.trongrid.io (без ключа — 1 запрос/с)
TRONGRID_API_KEY=''
# TRONGRID_RPS='10'
# TRONGRID_DAILY_BUDGET='90000'

# Воркер
INGEST_MODE='firehose'          # или poll (для < ~30 кошельков)
# WORKER_TICK_SEC='15'
# POLL_INTERVAL_SEC='120'
# BACKFILL_DAYS='30'
# BACKFILL_MAX_PAGES='100'
# BALANCE_SWEEP_HOURS='6'

ANALYTICS_TZ='Asia/Yerevan'
# DATABASE_POOL_MAX='10'

# Паттерны: как часто сканировать и за сколько дней
# PATTERN_SCAN_MIN='60'
# PATTERN_SCAN_DAYS='7'

# Telegram: токен от @BotFather; чат выбирается в дашборде (раздел «Уведомления»)
TELEGRAM_BOT_TOKEN=''
# TELEGRAM_CHAT_ID=''            # необязательно, если чат выбран в интерфейсе
# Адрес дашборда для ссылок в сообщениях (с телефона — IP этого Mac в локальной сети)
DASHBOARD_URL='http://127.0.0.1:3000'
